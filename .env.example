# All variables are optional and are read at build time by Vite. None are secrets.

# Mirror for model files (must serve the same layout as huggingface.co). Default: huggingface.co
# VITE_MODEL_HOST=https://models.example.com/

# Set to 1 to try the WebGPU backend instead of WASM. Experimental: only WASM is tested.
# VITE_USE_WEBGPU=1

# Base path when deploying under a sub-path, e.g. GitHub Pages project sites.
# TUFT_BASE=/tuft/
